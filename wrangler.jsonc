{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "jkt48-restock-notifier",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-21",
	"compatibility_flags": [
		"nodejs_compat"
	],
  "workers_dev": true,
  "triggers": {
    "crons": ["*/5 * * * *"]
	},
  "kv_namespaces": [
		{
			"binding": "STATE",
			"id": "1245e0ae153b4504b1ef54df9010194c"
    }
  ],
	"vars": {
		"MONITORED_CATEGORIES": "PHOTOCARD,TWO_SHOT,DIGITAL_PHOTOBOOK,VIDEO_CALL",
		"PUBLIC_BASE_URL": "https://jkt48-restock-notifier.estrella19.workers.dev"
	},
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1
		}
	}
}
